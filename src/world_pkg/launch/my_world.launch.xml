<launch>
    <!-- Starts up Gazebo using the specified world .sdf file -->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(env GZ_SIM_RESOURCE_PATH):$(find-pkg-share world_pkg)/world"/>

    <let name="sdf_path" value="$(find-pkg-share world_pkg)/world/monza.sdf" />
    <let name="gazebo_gui_config_path" value="$(find-pkg-share system_start_pkg)/config/keypublisher.config" />
    <include
        file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var sdf_path) -r --gui-config $(var gazebo_gui_config_path)" /> 
        <!-- loads in the .sdf file and then uses the -r tag to immediately run DartSim -->
    </include>
</launch>